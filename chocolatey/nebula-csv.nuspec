<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>nebula-csv</id>
    <version>1.0.5</version>
    <title>Nebula CSV Viewer</title>
    <iconUrl>https://cdn.jsdelivr.net/gh/Porkstone/nebula-csv@v1.0.5/build/icon.svg</iconUrl>
    <authors>Porkstone</authors>
    <owners>Porkstone</owners>
    <projectUrl>https://github.com/porkstone/nebula-csv</projectUrl>
    <packageSourceUrl>https://github.com/porkstone/nebula-csv/tree/main/chocolatey</packageSourceUrl>
    <projectSourceUrl>https://github.com/porkstone/nebula-csv</projectSourceUrl>
    <docsUrl>https://github.com/porkstone/nebula-csv#readme</docsUrl>
    <bugTrackerUrl>https://github.com/porkstone/nebula-csv/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/porkstone/nebula-csv/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Preview local CSV files with column hiding, sorting, and filtering.</summary>
    <description>Nebula CSV Viewer is a local, read-only Electron desktop application for CSV and TSV files. Hide and restore columns, sort text and numeric values, combine per-column filters with global search, and browse paginated results. Includes Light, Dark, and System appearance modes. No sign-in, backend, or file uploads. Supports UTF-8 delimited files up to 50 MB. Requires 64-bit Windows 10 or later.</description>
    <releaseNotes>https://github.com/porkstone/nebula-csv/releases/tag/v1.0.5</releaseNotes>
    <tags>csv tsv viewer electron nebula filter sort desktop</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
