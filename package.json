{
  "name": "nebula-csv",
  "private": true,
  "version": "1.0.5",
  "main": "electron/main.cjs",
  "description": "A private, local CSV viewer with column visibility, sorting and filtering",
  "author": "Porkstone",
  "license": "MIT",
  "repository": "https://github.com/porkstone/nebula-csv",
  "packageManager": "pnpm@11.15.1",
  "build": {
    "appId": "com.porkstone.nebulacsv",
    "productName": "Nebula CSV Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/*.node-test.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "executableName": "nebula-csv-viewer",
      "artifactName": "nebula-csv-viewer.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.cjs\"",
    "start": "node scripts/launch-electron.cjs",
    "test": "vitest run && node --test electron/files.node-test.cjs",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
